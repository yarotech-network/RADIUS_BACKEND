# Select production policy explicitly in the deployed process.
DJANGO_SETTINGS_MODULE=config.production_settings
DEBUG=False
SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
REDIS_URL=redis://127.0.0.1:6379/1

# PostgreSQL
DB_NAME=yarotech_radius
DB_USER=yarotech_radius
DB_PASSWORD=replace-with-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Test database location (defaults to localhost when omitted)
DB_TEST_NAME=test_yarotech_radius
DB_TEST_HOST=localhost
DB_TEST_PORT=5432

# Start with a short HSTS duration. Increase only after HTTPS is verified.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_X_FORWARDED_PROTO=False

# Payments and encrypted integration credentials
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store it in the deployment secret manager. Losing it makes encrypted credentials unrecoverable.
FERNET_KEY=

# Router provisioning and WireGuard
ROUTER_PROVISIONING_AGENT_KEYS=
ROUTER_PROVISIONING_AGENT_ALLOWED_NETWORKS=
WG_VPS_HOST=
WG_VPS_SSH_KEY=
WG_SSH_KNOWN_HOSTS=
WG_INTERFACE=wg0
WG_MANAGED_SUBNET=10.100.100.0/24
WG_SSH_USE_SUDO=True
WG_SAVE_CONFIG=True

# FreeRADIUS authentication endpoint used by the router onboarding probe
RADIUS_AUTH_HOST=radius
RADIUS_AUTH_PORT=1812
RADIUS_AUTH_TIMEOUT=3
RADIUS_COA_PORT=3799
RADIUS_COA_TIMEOUT=3

# WhatsApp
WHATSAPP_API_VERSION=v18.0
WHATSAPP_APP_SECRET=

# Configure a real delivery backend when password reset is implemented.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
# Resend API key for voucher access-code emails (leave empty to use EMAIL_BACKEND instead).
# The DEFAULT_FROM_EMAIL domain must be verified in Resend. Run the delivery worker on a schedule:
#   python manage.py process_payment_deliveries --limit 20   (every 30-60 seconds)
RESEND_API_KEY=
PASSWORD_RESET_FRONTEND_URL=https://app.example.com/reset-password?uid={uid}&token={token}
PASSWORD_RESET_TIMEOUT=3600
