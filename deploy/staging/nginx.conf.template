# Replace stage-radius.yarotech.com.ng after DNS is configured.
# Save as its own sites-available entry; never overwrite test.yarotech.com.ng.
server {
    listen 80;
    listen [::]:80;
    server_name stage-radius.yarotech.com.ng;
    root /opt/yarotech-radius-staging/current/frontend/dist;
    index index.html;
    access_log off; # Payment references and reset tokens must not enter access logs.
    error_log /var/log/nginx/yarotech-radius-staging.error.log;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    location ^~ /api/v1/radius/ { return 404; }
    location /api/ {
        access_log off;
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /health/ {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / { try_files $uri $uri/ /index.html; }
}
# Let certbot add TLS and HTTP->HTTPS redirection for this staging host only.
