[Unit]
Description=Yarotech isolated staging API
After=network-online.target postgresql.service redis-server.service

[Service]
User=yarotech-staging
Group=www-data
WorkingDirectory=/opt/yarotech-radius-staging/current/backend
EnvironmentFile=/etc/yarotech-radius-staging/backend.env
ExecStart=/opt/yarotech-radius-staging/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8020 --workers 2 --timeout 60 --error-logfile -
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# Initial rehearsal may reach only PostgreSQL, Redis and Nginx on loopback.
IPAddressDeny=any
IPAddressAllow=localhost
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/yarotech-radius-staging

[Install]
WantedBy=multi-user.target
