[Unit]
Description=Yarotech staging customer device accounting synchronization
After=postgresql.service

[Service]
Type=oneshot
User=yarotech-staging
Group=yarotech-staging
WorkingDirectory=/opt/yarotech-radius-staging/current/backend
ExecStart=/usr/local/bin/yarotech-staging-manage sync_device_access
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yarotech-radius-staging
