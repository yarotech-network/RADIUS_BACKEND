# Base URL of the Yarotech RADIUS API (v1). Use a relative path when the frontend
# is served behind the same origin as Django (Nginx proxies /api to Gunicorn),
# or a full URL such as https://api.example.com/api/v1 for a separate origin
# (remember to add the frontend origin to CORS_ALLOWED_ORIGINS on the backend).
VITE_API_BASE_URL=/api/v1

# Only used by the Vite dev server: where to proxy /api and /health during development.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Display name shown in the UI.
VITE_APP_NAME=Yarotech RADIUS

# Optional: POST endpoint for the production error reporter (window errors,
# unhandled rejections and React error boundaries). Best effort, no retries.
# Leave empty to disable remote reporting (errors still surface in the console).
VITE_ERROR_REPORT_ENDPOINT=
